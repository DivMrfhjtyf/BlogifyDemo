<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Group chat | Blogify</title>
  <style>
    :root{--bg:#fff;--surface:#fff;--input:#f2f2f4;--received:#efeff1;--sent:#3797f0;--text:#111;--muted:#737373;--line:#e3e3e6;--danger:#ed4956}
    html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}*{box-sizing:border-box}button,input,textarea{font:inherit}
    .page{height:100dvh;display:flex;align-items:center;justify-content:center}.shell{width:min(850px,100%);height:100dvh;background:var(--surface);display:flex;flex-direction:column;overflow:hidden;border-left:1px solid var(--line);border-right:1px solid var(--line)}
    .head{height:64px;display:flex;align-items:center;gap:10px;padding:7px 10px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.96);backdrop-filter:blur(18px);z-index:2}.back,.menu{width:42px;height:42px;border:0;border-radius:12px;background:transparent;display:grid;place-items:center;cursor:pointer;color:var(--text)}.back:hover,.menu:hover{background:var(--input)}.group-info{min-width:0;flex:1;display:flex;align-items:center;gap:10px;cursor:pointer}.group-avatar{width:44px;height:44px;border-radius:14px;object-fit:cover;background:var(--input)}.group-name{font-size:15px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.group-members{font-size:11px;color:var(--muted);margin-top:2px}.head-menu{position:relative}.menu-sheet{position:absolute;right:0;top:48px;width:190px;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:0 15px 40px rgba(0,0,0,.15);padding:6px;display:none;z-index:10}.menu-sheet.open{display:block}.menu-sheet button{width:100%;border:0;background:transparent;text-align:left;padding:11px;border-radius:10px;cursor:pointer;color:var(--text)}.menu-sheet button:hover{background:var(--input)}
    .messages{flex:1;overflow:auto;padding:12px 18px 18px;scroll-behavior:smooth}.empty{text-align:center;color:var(--muted);padding:60px 20px}.row{display:flex;gap:7px;align-items:flex-end;margin:0 0 9px}.row.mine{justify-content:flex-end}.avatar{width:28px;height:28px;border-radius:50%;object-fit:cover;background:var(--input);flex:none}.bubble-wrap{max-width:min(70%,580px)}.sender{font-size:10px;color:var(--muted);margin:0 0 3px 3px;font-weight:700}.bubble{padding:9px 12px;border-radius:18px;background:var(--received);white-space:pre-wrap;overflow-wrap:anywhere}.mine .bubble{background:var(--sent);color:#fff;border-bottom-right-radius:5px}.row:not(.mine) .bubble{border-bottom-left-radius:5px}.meta{font-size:9px;color:var(--muted);margin:3px 4px}.mine .meta{text-align:right}.typing{height:22px;padding:0 18px;color:var(--muted);font-size:11px}.composer{display:flex;gap:7px;padding:8px 10px max(8px,env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--surface)}.input{flex:1;min-height:42px;max-height:120px;border:0;outline:0;background:var(--input);border-radius:22px;padding:10px 14px;resize:none}.send{width:42px;height:42px;border:0;border-radius:50%;background:var(--sent);color:#fff;display:grid;place-items:center;cursor:pointer}.sheet{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:flex-end;z-index:50}.sheet.open{display:flex}.card{width:min(520px,100%);background:var(--surface);border-radius:20px 20px 0 0;padding:12px;max-height:80dvh;overflow:auto}.card button{width:100%;border:0;background:transparent;text-align:left;padding:13px;border-radius:11px;cursor:pointer}.card button:hover{background:var(--input)}.danger{color:var(--danger)!important}
    @media(min-width:700px){.shell{height:calc(100dvh - 30px);border-radius:18px;box-shadow:0 12px 50px rgba(0,0,0,.1)}}
    html[data-theme="dark"] body,body.dark,body.dark-mode,body[data-theme="dark"]{--bg:#000;--surface:#000;--input:#171717;--received:#262626;--text:#fff;--muted:#a8a8a8;--line:#292929}
  </style>
</head>
<body>
  <main class="page"><section class="shell">
    <header class="head"><button class="back" id="back"><i class="fas fa-arrow-left"></i></button><div class="group-info"><img id="avatar" class="group-avatar" src="/imgs/default.png"><div><div id="name" class="group-name">Loading…</div><div id="members" class="group-members">Group</div></div></div><div class="head-menu"><button class="menu" id="menu"><i class="fas fa-ellipsis-v"></i></button><div class="menu-sheet" id="menuSheet"><button id="viewMembers">View members</button><button id="muteGroup">Mute</button><button id="pinGroup">Pin</button></div></div></header>
    <div class="messages" id="messages"><div class="empty">Loading group…</div></div><div class="typing" id="typing"></div>
    <form class="composer" id="composer"><textarea id="input" class="input" rows="1" maxlength="5000" placeholder="Message group…"></textarea><button class="send" type="submit"><i class="fas fa-paper-plane"></i></button></form>
  </section></main>
  <div class="sheet" id="actionSheet"><div class="card"><button id="replyAction">Reply</button><button id="deleteMe">Delete for me</button><button id="unsend" class="danger">Unsend for everyone</button><button id="cancel">Cancel</button></div></div>
  <div class="sheet" id="membersSheet"><div class="card"><h3 style="margin:4px 4px 10px">Group members</h3><div id="memberList"></div><button id="closeMembers">Close</button></div></div>
  <script src="/socket.io/socket.io.js"></script>
  <script>
  (()=>{const id=new URLSearchParams(location.search).get('conversation');const myId=<%- JSON.stringify(String(user?._id||'')) %>;let group=null,socket=null,messages=[];let selected=null;const $=x=>document.getElementById(x);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const avatar=u=>u?.profileImageURL||'/imgs/default.png';const toast=m=>window.notify?.error?notify.error(m):console.warn(m);
  async function load(){try{const r=await fetch('/messages/chatlog-api/groups/'+encodeURIComponent(id),{credentials:'same-origin'}),d=await r.json();if(!r.ok||!d.success)throw Error(d.message||'Unable to load group');group=d.conversation;$('name').textContent=group.groupName||'Group';$('members').textContent=(group.participants||[]).length+' members';$('avatar').src=group.groupAvatar||avatar(group.participants?.find(x=>String(x._id)===String(group.createdBy)))||'/imgs/default.png';renderMembers();const h=await fetch('/messages/'+encodeURIComponent(id)+'?limit=100',{credentials:'same-origin'}),hd=await h.json();if(!h.ok||!hd.success)throw Error(hd.message||'Unable to load messages');messages=hd.messages||[];render();initSocket()}catch(e){$('messages').innerHTML='<div class="empty">'+esc(e.message)+'</div>'}}
  function render(){const box=$('messages');box.innerHTML=messages.length?'':'<div class="empty">No messages yet. Start the group chat.</div>';let last='';for(const m of messages){const d=new Date(m.createdAt).toDateString();if(d!==last){const day=document.createElement('div');day.className='empty';day.style.padding='12px;font-size:10px';day.textContent=new Date(m.createdAt).toLocaleDateString();box.appendChild(day);last=d}const mine=String(m.senderId?._id||m.senderId)===String(myId);const row=document.createElement('div');row.className='row '+(mine?'mine':'');row.dataset.id=m._id;if(!mine){const img=document.createElement('img');img.className='avatar';img.src=avatar(m.senderId);row.appendChild(img)}const wrap=document.createElement('div');wrap.className='bubble-wrap';if(!mine){const s=document.createElement('div');s.className='sender';s.textContent=m.senderId?.fullName||'Member';wrap.appendChild(s)}const b=document.createElement('div');b.className='bubble';b.textContent=m.deleted?'Message deleted':(m.text||'');wrap.appendChild(b);const meta=document.createElement('div');meta.className='meta';meta.textContent=new Date(m.createdAt).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'})+(m.edited?' · edited':'');wrap.appendChild(meta);row.appendChild(wrap);box.appendChild(row);if(!m.deleted)b.addEventListener('contextmenu',e=>{e.preventDefault();openAction(m)});b.addEventListener('dblclick',()=>!m.deleted&&openAction(m))}box.scrollTop=box.scrollHeight}
  function renderMembers(){$('memberList').innerHTML=(group?.participants||[]).map(p=>'<div style="display:flex;align-items:center;gap:10px;padding:9px 4px"><img src="'+esc(avatar(p))+'" style="width:40px;height:40px;border-radius:50%;object-fit:cover"><div><strong>'+esc(p.fullName||'User')+'</strong><div style="font-size:11px;color:var(--muted)">'+(String(p._id)===String(group?.admins?.[0]||'')?'Admin':'Member')+'</div></div></div>').join('')}
  function openAction(m){selected=m;$('actionSheet').classList.add('open');$('unsend').style.display=String(m.senderId?._id||m.senderId)===String(myId)?'block':'none'}function closeAction(){$('actionSheet').classList.remove('open');selected=null}
  function initSocket(){if(!window.io)return;socket=window.io({withCredentials:true});socket.on('connect',()=>{socket.emit('group:join',id);socket.emit('group:read',id)});socket.on('message:new',m=>{if(String(m.conversationId)!==String(id))return;messages.push(m);render();if(String(m.senderId?._id||m.senderId)!==String(myId))socket.emit('group:read',id)});socket.on('message:unsent',d=>{const m=messages.find(x=>String(x._id)===String(d.messageId));if(m){m.deleted=true;m.text='';render()}});socket.on('message:deletedForMe',d=>{messages=messages.filter(x=>String(x._id)!==String(d.messageId));render()});socket.on('group:error',d=>toast(d.message||'Group action failed'));socket.on('message:action:error',d=>toast(d.message||'Group action failed'))}
  $('composer').addEventListener('submit',e=>{e.preventDefault();const text=$('input').value.trim();if(!text||!socket?.connected)return;if(!id)return;socket.emit('group:send',{conversationId:id,text});$('input').value='';$('input').style.height='auto'});$('input').addEventListener('input',()=>{$('input').style.height='auto';$('input').style.height=Math.min($('input').scrollHeight,120)+'px';if(socket?.connected)socket.emit('group:typing:start',id)});$('back').onclick=()=>location.href='/messages/chatlog';$('menu').onclick=()=>$('menuSheet').classList.toggle('open');$('viewMembers').onclick=()=>{$('menuSheet').classList.remove('open');$('membersSheet').classList.add('open')};$('closeMembers').onclick=()=>$('membersSheet').classList.remove('open');$('cancel').onclick=closeAction;$('actionSheet').addEventListener('click',e=>{if(e.target.id==='actionSheet')closeAction()});$('deleteMe').onclick=()=>{if(selected&&socket?.connected){socket.emit('message:deleteForMe',{conversationId:id,messageId:selected._id});closeAction()}};$('unsend').onclick=()=>{if(selected&&socket?.connected&&confirm('Unsend this message for everyone?')){socket.emit('message:unsend',{conversationId:id,messageId:selected._id});closeAction()}};$('pinGroup').onclick=async()=>{const r=await fetch('/messages/chatlog-api/conversations/'+id+'/pin',{method:'PATCH'});const d=await r.json();toast(d.pinned?'Group pinned':'Group unpinned');$('menuSheet').classList.remove('open')};$('muteGroup').onclick=async()=>{const r=await fetch('/messages/chatlog-api/conversations/'+id+'/mute',{method:'PATCH'});const d=await r.json();toast(d.muted?'Group muted':'Group unmuted');$('menuSheet').classList.remove('open')};load()})();
  </script>
</body></html>
