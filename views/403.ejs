<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <meta name="robots" content="noindex, nofollow">
    <title>403 · Access denied | Blogify</title>
    <style>
        .denied-page{min-height:calc(100vh - 90px);display:grid;place-items:center;padding:2rem 1rem;color:var(--bs-body-color)}
        .denied-card{width:min(100%,650px);text-align:center;padding:clamp(1.5rem,5vw,3.5rem);border:1px solid var(--bs-border-color);border-radius:24px;background:var(--bs-body-bg);box-shadow:0 18px 55px rgba(0,0,0,.08)}
        .denied-code{font-size:clamp(4rem,15vw,7rem);font-weight:800;letter-spacing:-.07em;line-height:1;color:#e05252}
        .denied-symbol{width:76px;height:76px;margin:0 auto 1.25rem;border-radius:22px;display:grid;place-items:center;background:rgba(224,82,82,.12);color:#e05252;font-size:2rem}
        .denied-card p{max-width:480px;margin:0 auto 1.75rem;color:var(--bs-secondary-color)}
        .denied-actions{display:flex;justify-content:center;gap:.75rem;flex-wrap:wrap}
        @media(prefers-color-scheme:dark){.denied-card{box-shadow:0 18px 55px rgba(0,0,0,.28)}}
    </style>
</head>
<body>
    <%- include("./partials/nave") %>
    <main class="denied-page">
        <section class="denied-card" aria-labelledby="denied-title">
            <div class="denied-symbol" aria-hidden="true"><i class="fas fa-lock"></i></div>
            <div class="denied-code" aria-hidden="true">403</div>
            <h1 id="denied-title" class="h2 fw-bold mt-3 mb-3">You can’t edit this post</h1>
            <p><%= typeof message !== "undefined" && message ? message : "This page is limited to the post owner. You can return to Blogify or go back to the previous page." %></p>
            <div class="denied-actions">
                <a class="btn btn-primary btn-lg" href="<%= typeof homeUrl !== 'undefined' ? homeUrl : '/' %>"><i class="fas fa-house me-2"></i>Back to Blogify</a>
                <a class="btn btn-outline-secondary btn-lg" href="javascript:history.back()"><i class="fas fa-arrow-left me-2"></i>Go back</a>
            </div>
            <div class="small text-muted mt-4">HTTP 403 · Forbidden</div>
        </section>
    </main>
    <%- include("./partials/scripts") %>
</body>
</html>
