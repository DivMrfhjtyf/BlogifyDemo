<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Follow Requests | Blogify</title>
<style>
body{font-family:system-ui,sans-serif;background:#f6f7fb;color:#172033;margin:0}.wrap{max-width:720px;margin:80px auto;padding:20px}.card{background:#fff;border:1px solid #e6e8ef;border-radius:16px;padding:18px;margin:12px 0;display:flex;align-items:center;gap:14px}.avatar{width:52px;height:52px;border-radius:50%;object-fit:cover}.info{flex:1}.info strong{display:block}.info span{color:#718096;font-size:.85rem}.actions{display:flex;gap:8px}.btn{border:0;border-radius:10px;padding:9px 13px;font-weight:700;cursor:pointer}.btn:disabled{opacity:.55;cursor:not-allowed}.accept{background:#159570;color:#fff}.reject{background:#f1f3f7;color:#172033}.empty{text-align:center;color:#718096;padding:60px 10px}.error{text-align:center;color:#b42318;background:#fff0f0;border:1px solid #ffd0d0;border-radius:12px;padding:14px;margin:12px 0}
</style>
</head>
<body>
<main class="wrap">
<h1>Follow requests</h1>
<p>People who want to follow your private account.</p>
<div id="list"><div class="empty">Loading…</div></div>
</main>
<script>
const list=document.getElementById('list');

function escapeHtml(v){
  return String(v??'').replace(/[&<>\'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
}

async function load(){
  try{
    const r=await fetch('/follow/requests',{method:'GET',credentials:'same-origin',headers:{'Accept':'application/json'}});
    const d=await r.json().catch(()=>({success:false,message:'Invalid server response'}));
    if(!r.ok||!d.success) throw new Error(d.message||'Unable to load follow requests');
    if(!Array.isArray(d.requests)||!d.requests.length){list.innerHTML='<div class="empty">No pending follow requests.</div>';return;}
    list.innerHTML=d.requests.filter(x=>x&&x.requester).map(x=>`<div class="card" data-id="${escapeHtml(x._id)}"><img class="avatar" src="${escapeHtml(x.requester.profileImageURL||'/imgs/default.png')}" onerror="this.src='/imgs/default.png'" alt=""><div class="info"><strong>${escapeHtml(x.requester.fullName)}</strong><span>${escapeHtml(x.requester.bio||'Wants to follow you')}</span></div><div class="actions"><button type="button" class="btn accept" onclick="respond('${escapeHtml(x._id)}','accept',this)">Accept</button><button type="button" class="btn reject" onclick="respond('${escapeHtml(x._id)}','reject',this)">Reject</button></div></div>`).join('');
  }catch(e){
    console.error('Follow request load error:',e);
    list.innerHTML=`<div class="error">${escapeHtml(e.message||'Unable to load follow requests')} <button type="button" onclick="load()">Retry</button></div>`;
  }
}

async function respond(id,action,btn){
  const card=btn.closest('.card');
  if(!card||card.dataset.busy==='1') return;
  card.dataset.busy='1';
  card.querySelectorAll('button').forEach(b=>b.disabled=true);
  const original=btn.textContent;
  btn.textContent=action==='accept'?'Accepting…':'Rejecting…';
  try{
    const r=await fetch('/follow/requests/'+encodeURIComponent(id)+'/'+action,{
      method:'POST',
      credentials:'same-origin',
      headers:{'Accept':'application/json','Content-Type':'application/json'}
    });
    const d=await r.json().catch(()=>({success:false,message:'Invalid server response'}));
    if(!r.ok||!d.success) throw new Error(d.message||'Request failed');

    card.remove();
    if(!document.querySelector('.card')) list.innerHTML='<div class="empty">No pending follow requests.</div>';
  }catch(e){
    console.error('Follow request response error:',e);
    card.dataset.busy='0';
    card.querySelectorAll('button').forEach(b=>b.disabled=false);
    btn.textContent=original;
    alert(e.message||'Request failed. Please try again.');
  }
}

load();
</script>
</body>
</html>
